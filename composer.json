{
    "name": "simbada/legacy-app",
    "description": "Simbada BMD Application - Modernized to PHP 8.4",
    "type": "project",
    "require": {
        "php": "^8.3 || ^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "mysql_adapter.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse -l 4 src",
        "rector": "rector process --dry-run"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
